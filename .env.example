# Copy to .env in the source project root if it does not already exist.
# The MCP server and approval tools read nonsecret settings from this file.
# Do not put tokens or passwords here; run `confluence-mcp-store-pat` from the project virtual environment.

# 写操作开关与空间白名单（可选）
# CONFLUENCE_ENABLE_WRITES=true
# CONFLUENCE_WRITE_SPACES=OPS

# Set the Confluence base URL, including a context path if present.
ATLASSIAN_CONFLUENCE_URL=https://confluence.example.com/confluence

# Optional private CA bundle path. TLS verification stays enabled.
# ATLASSIAN_CONFLUENCE_CA_BUNDLE=

